<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="467">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="Area de atuação:&#xD;&#xA;" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="33,31,0,0" VerticalAlignment="Top" Width="103" Height="29"/>
        <TextBox x:Name="TextboxArea" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="211,37,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="216" TextChanged="TextBox_TextChanged"/>
        <Label Content="Descreva sua ideia aqui:" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="41,104,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TextBoxIdeia" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="41,158,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="386" Height="99" TextChanged="TextBox_TextChanged_1"/>
        <Label Content="Custo:" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="41,350,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TextBoxCusto" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="135,354,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="136" TextChanged="TextBox_TextChanged"/>
        <Button Content="Cadastrar" HorizontalAlignment="Left" Margin="373,352,0,0" VerticalAlignment="Top" Click="Button_Click" Grid.Column="1"/>

    </Grid>
</Window>
